// Schema focado no fluxo "login por e-mail + voto único por categoria".
// As tabelas User/Account/Session/VerificationToken seguem exatamente o
// formato que o adapter do NextAuth espera — não renomeie os campos.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Tabelas do NextAuth (login por e-mail / "magic link") ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  votes    Vote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Token de uso único gerado quando alguém pede o link de login por e-mail.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Modelos do próprio Geek Music Awards ----------

model Artist {
  id    String @id @default(cuid())
  slug  String @unique
  name  String

  votes Vote[]
}

model Category {
  id   String @id @default(cuid())
  slug String @unique
  name String

  votes Vote[]
}

// Um voto é sempre de um usuário autenticado, pra um artista, numa categoria.
// A constraint @@unique impede o mesmo usuário votar duas vezes no mesmo
// artista dentro da mesma categoria — mesmo que ele tente pela API direto.
model Vote {
  id         String   @id @default(cuid())
  userId     String
  artistId   String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist   Artist   @relation(fields: [artistId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, artistId, categoryId])
  @@index([artistId])
  @@index([userId])
}
