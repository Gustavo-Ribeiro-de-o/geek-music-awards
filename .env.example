# Banco de dados (Postgres). Ex: Neon, Supabase, Railway, ou Postgres local.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/geek_music_awards"

# URL pública do seu app (o NextAuth usa isso para montar os links de login).
NEXTAUTH_URL="http://localhost:3000"

# Chave secreta usada pelo NextAuth para assinar sessões e tokens.
# Gere uma com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-uma-chave-aleatoria-longa"

# Servidor SMTP usado para enviar o e-mail com o link de login.
# Em desenvolvimento, o mais fácil é criar uma conta grátis no https://resend.com
# ou usar um SMTP de testes como o https://mailtrap.io (não entrega de verdade,
# mas deixa você ver o e-mail chegando num painel).
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="sua-api-key-aqui"
EMAIL_FROM="Geek Music Awards <login@seudominio.com>"

# Quantos votos cada usuário logado pode dar no total (somando todas as categorias).
MAX_VOTES_PER_USER="3"

# Senha da "Área da equipe" (dashboard com os números reais de votos).
# Troque por uma senha sua antes de divulgar o site.
TEAM_PASSWORD="GMW20262508"
